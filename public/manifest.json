{
  "manifest_version": 3,
  "name": "aiom — AI on Message",
  "version": "1.0.0",
  "description": "Chat with AI providers from your browser. Select text and send it directly.",
  "permissions": ["contextMenus", "storage", "activeTab", "sidePanel"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
